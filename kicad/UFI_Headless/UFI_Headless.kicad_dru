(version 1)

# THT ground pins of the IDC headers also connect to the In1 GND plane, so a single
# thermal spoke on an outer pour is sufficient.
(rule "tht_gnd_single_spoke"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.NetName == 'GND'")
	(constraint min_resolved_spokes 1))

# J6/J7/J12 (IDC box headers) sit on the board edge on purpose, J1 (USB-C) and J22 (RJ45)
# protrude over the input edge by design (v1.0: receptacle openings outside the enclosure
# wall); their library outlines overhang the edge and the fab clips that silkscreen.  Only
# silk-vs-edge pairs of these footprints are ignored; library footprints stay unmodified.
(rule "idc_edge_silk"
	(condition "(A.memberOfFootprint('J6') || A.memberOfFootprint('J7') || A.memberOfFootprint('J12') || A.memberOfFootprint('J1') || A.memberOfFootprint('J22') || B.memberOfFootprint('J6') || B.memberOfFootprint('J7') || B.memberOfFootprint('J12') || B.memberOfFootprint('J1') || B.memberOfFootprint('J22')) && (A.Layer == 'Edge.Cuts' || B.Layer == 'Edge.Cuts')")
	(constraint silk_clearance (min 0mm))
	(severity ignore))
