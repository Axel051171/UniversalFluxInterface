(version 1)

# THT GND pads (terminal block, headers, mounting holes) also reach the solid B.Cu GND pour,
# so a single thermal spoke on the F.Cu pour is sufficient.
(rule "tht_gnd_single_spoke"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.NetName == 'GND'")
	(constraint min_resolved_spokes 1))
